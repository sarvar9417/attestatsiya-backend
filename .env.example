# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_service_role_key_here

# ─── Server ─────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Demo Mode (login-free access) ─────────────────────────────
# Set DEMO_MODE=true to bypass authentication for testing/demo
# DEMO_MODE=true
# DEMO_USER_EMAIL=demo@attestatsiya.uz
# DEMO_USER_PASSWORD=demo123456

# ─── Auth ────────────────────────────────────────────────────────
# Parolni tiklash xatidagi redirect manzil (frontend root URL)
# Prod (Vercel): https://attestatsiya-five.vercel.app
AUTH_REDIRECT_URL=http://localhost:3000

# ─── Vercel (serverless) ────────────────────────────────────────────
# Backend'ni Vercel'da deploy qilish uchun api/[...all].ts ishlatiladi.
# Vercel project env vars (backend loyihasi, to'g'ridan-to'g'ri nomlar):
#   SUPABASE_URL          -> https://your-project.supabase.co
#   SUPABASE_SERVICE_KEY  -> service role key (secret, browser'ga kirmaydi)
#   AUTH_REDIRECT_URL     -> frontend URL (masalan https://attestatsiya-five.vercel.app)
# Frontend loyihasi env vars:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_API_BASE_URL (backend URL)
